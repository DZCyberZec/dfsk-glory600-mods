<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="it.cyberzec.home" android:versionCode="30" android:versionName="0.23">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="28" />
    <!-- CyberZec Set changes Home settings and reads its status (apps signed with the same key) -->
    <permission android:name="it.cyberzec.permission.SETTINGS" android:protectionLevel="signature" />
    <uses-permission android:name="it.cyberzec.permission.SETTINGS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <!-- read the media session (granted only to apps signed with the system key: without it the media card stays empty) -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />

    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:allowBackup="false" android:usesCleartextTraffic="false">
        <!-- bw.car.proxy exists only on the car; in the emulator the climate card shows "non disponibile" -->
        <uses-library android:name="bw.car.proxy" android:required="false" />
        <activity android:name=".HomeActivity" android:label="@string/app_name"
            android:launchMode="singleTask" android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true" android:excludeFromRecents="true"
            android:resumeWhilePausing="true" android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|locale|layoutDirection"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".SettingsReceiver" android:exported="true"
            android:permission="it.cyberzec.permission.SETTINGS">
            <intent-filter>
                <action android:name="it.cyberzec.home.SET" />
            </intent-filter>
        </receiver>
        <provider android:name=".StatusProvider" android:authorities="it.cyberzec.home.status"
            android:exported="true" android:readPermission="it.cyberzec.permission.SETTINGS"
            android:writePermission="it.cyberzec.permission.SETTINGS" />
    </application>
</manifest>
